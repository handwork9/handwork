# Simple Dockerfile for NestJS
FROM node:20-alpine

# Install build dependencies for bcrypt and other native modules
RUN apk add --no-cache python3 make g++ 

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev for build)
RUN npm ci

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Create symlink so dist/main.js works
RUN ln -s /app/dist/src/main.js /app/dist/main.js

# Note: We keep all dependencies since we need typeorm for migrations
# RUN npm prune --production

# Expose port
EXPOSE 3001

# Create a startup script that runs migrations then starts the app
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'echo "Running migrations..."' >> /app/start.sh && \
    echo 'npx typeorm migration:run -d dist/src/database/data-source.js || echo "Migration failed or no migrations to run"' >> /app/start.sh && \
    echo 'echo "Starting application..."' >> /app/start.sh && \
    echo 'node dist/main.js' >> /app/start.sh && \
    chmod +x /app/start.sh

# Start the app with migrations
CMD ["/app/start.sh"]
