# Simple Dockerfile for NestJS
FROM node:20-alpine

# Install build dependencies for bcrypt and other native modules
RUN apk add --no-cache python3 make g++ 

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev for build)
RUN npm ci

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Create symlink so dist/main.js works
RUN ln -s /app/dist/src/main.js /app/dist/main.js

# Expose port
EXPOSE 3001

# Start the app (synchronize: true will auto-create tables)
CMD ["node", "dist/main.js"]
