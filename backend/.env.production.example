# =============================================================================
# HANDWORK BACKEND - PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# 
# SECURITY CHECKLIST:
# ✓ This file should be in .gitignore (NEVER commit actual .env files)
# ✓ Copy this to .env on your production server
# ✓ Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# ✓ Restrict file permissions: chmod 600 .env
# ✓ Rotate secrets regularly
#
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1

# Your production domain (used for CORS)
FRONTEND_URL=https://handwork.com
ADMIN_URL=https://admin.handwork.com
API_URL=https://api.handwork.com

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# Use a managed database service (AWS RDS, DigitalOcean, etc.)
# -----------------------------------------------------------------------------
DATABASE_HOST=your-db-host.region.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_USERNAME=handwork_prod
DATABASE_PASSWORD=<GENERATE_STRONG_PASSWORD_32_CHARS_MIN>
DATABASE_NAME=handwork_production
DATABASE_SSL=true

# -----------------------------------------------------------------------------
# REDIS
# Use a managed Redis service (AWS ElastiCache, Redis Cloud, etc.)
# -----------------------------------------------------------------------------
REDIS_HOST=your-redis-host.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=<STRONG_REDIS_PASSWORD>

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# Generate with: openssl rand -base64 64
# MUST be at least 32 characters, ideally 64+
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=<GENERATE_64_CHAR_SECRET_1>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<GENERATE_64_CHAR_SECRET_2>
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# SMS / OTP (Twilio)
# Get credentials from: https://console.twilio.com
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=<YOUR_TWILIO_AUTH_TOKEN>
TWILIO_PHONE_NUMBER=+1234567890
OTP_EXPIRES_MINUTES=5

# -----------------------------------------------------------------------------
# PAYMENTS
# -----------------------------------------------------------------------------
# Stripe (International)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=ngn

# Paystack (Nigeria)
# Get from: https://dashboard.paystack.com/#/settings/developer
# USE LIVE KEYS (pk_live_xxx, sk_live_xxx) FOR PRODUCTION!
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# FILE STORAGE (AWS S3)
# Create a dedicated IAM user with minimal permissions
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_KEY>
AWS_REGION=us-east-1
AWS_S3_BUCKET=handwork-production-uploads
AWS_S3_SIGNED_URL_EXPIRES=3600

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (Firebase)
# Download service account JSON from Firebase Console
# Store the private key securely (consider using secrets manager)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=handwork-production
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@handwork-production.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<YOUR_PRIVATE_KEY>\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# EMAIL (Use a dedicated email service for production)
# Recommended: SendGrid, Mailgun, AWS SES
# -----------------------------------------------------------------------------
# For Gmail (NOT recommended for production)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# For SendGrid (Recommended)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM_EMAIL=noreply@handwork.com
SMTP_FROM_NAME=Handwork

# -----------------------------------------------------------------------------
# MAPS (Google Maps API)
# Restrict API key to your domains in Google Cloud Console
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# ERROR MONITORING (Sentry)
# Get DSN from: https://sentry.io
# -----------------------------------------------------------------------------
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o123456.ingest.sentry.io/1234567

# -----------------------------------------------------------------------------
# RATE LIMITING
# Adjust based on expected traffic
# -----------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# -----------------------------------------------------------------------------
# DISPATCH CONFIGURATION
# -----------------------------------------------------------------------------
DISPATCH_MAX_DELIVERY_MINUTES=45
DISPATCH_QUICK_DELIVERY_MINUTES=30
DISPATCH_RIDER_OFFER_TIMEOUT_SECONDS=30
DISPATCH_MAX_RIDER_OFFERS=5
DISPATCH_RIDER_SEARCH_RADIUS_KM=15
DISPATCH_LOCATION_STALE_SECONDS=120

# -----------------------------------------------------------------------------
# LOGGING
# Set to 'error' or 'warn' in production to reduce noise
# -----------------------------------------------------------------------------
LOG_LEVEL=warn
