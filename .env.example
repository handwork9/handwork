# Expo Environment Variables
# Copy this file to .env and fill in your values

# Stripe Publishable Key (get from Stripe dashboard)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Google Maps API Key (optional - for maps)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Mapbox Access Token (optional - alternative maps)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Google OAuth Client IDs (get from Google Cloud Console)
# Create OAuth 2.0 credentials at: https://console.cloud.google.com/apis/credentials
# 1. Create a Web application client ID
# 2. Create an iOS client ID (needs your app's Bundle ID)
# 3. Create an Android client ID (needs your SHA-1 fingerprint)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
