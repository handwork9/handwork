# Expo Environment Variables
# Copy this file to .env and fill in your values

# API Configuration (for real device testing, use your machine's IP)
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
EXPO_PUBLIC_WS_URL=http://localhost:3001

# Stripe Publishable Key (get from Stripe dashboard)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Google Maps API Key (optional - for maps)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Mapbox Access Token (required for maps)
# Get your token from https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_public_token_here

# Google OAuth Client IDs (get from Google Cloud Console)
# Create OAuth 2.0 credentials at: https://console.cloud.google.com/apis/credentials
# 1. Create a Web application client ID
# 2. Create an iOS client ID (needs your app's Bundle ID)
# 3. Create an Android client ID (needs your SHA-1 fingerprint)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Error Tracking (Sentry)
# Get your DSN from https://sentry.io
EXPO_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
